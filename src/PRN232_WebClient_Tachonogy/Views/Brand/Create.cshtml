@model PRN232_WebClient_Tachonogy.DTOs.CreateBrandRequest
@{
    ViewData["Title"] = "Create New Brand";
}

<h2>@ViewData["Title"]</h2>

<form asp-controller="Brand" asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="BrandName" class="form-label"></label>
        <input asp-for="BrandName" type="text" class="form-control" />
        <span asp-validation-for="BrandName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="BrandDescription" class="form-label"></label>
        <textarea asp-for="BrandDescription" class="form-control" rows="3"></textarea>
        <span asp-validation-for="BrandDescription" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="WebsiteUrl" class="form-label"></label>
        <input asp-for="WebsiteUrl" type="url" class="form-control" placeholder="https://example.com" />
        <span asp-validation-for="WebsiteUrl" class="text-danger"></span>
    </div>


    <button type="submit" class="btn btn-success">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
