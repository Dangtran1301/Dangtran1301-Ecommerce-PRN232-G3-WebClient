@model PRN232_WebClient_Tachonogy.DTOs.PagedResult<PRN232_WebClient_Tachonogy.DTOs.BrandDto>

@{
    ViewData["Title"] = "Brand List";
    var keyword = ViewBag.Keyword as string ?? "";
    var currentPage = ViewBag.Page ?? 1;
    var maxPage = ViewBag.MaxPage ?? 1;
}

<div class="container py-4">
    <h2 class="text-center mb-4 fw-bold text-primary">
        <i class="bi bi-database me-2"></i>@ViewData["Title"]
    </h2>
    <form asp-action="Index" method="get" class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-3">
        <div class="d-flex flex-grow-1" style="max-width: 500px;">
            <input type="text" name="keyword" value="@keyword" class="form-control me-2"
                   placeholder="🔍 Search brand..." />
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search"></i> Search
            </button>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-lg me-1"></i> Add New
            </a>
        }
    </form>
    @if (Model == null || !Model.Items.Any())
    {
        <div class="alert alert-info text-center py-4">
            <i class="bi bi-info-circle me-1"></i> No brands found.
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded-4 overflow-hidden">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark text-white text-uppercase">
                    <tr>
                        <th>Brand Name</th>
                        <th>Description</th>
                        <th>Website Url</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th class="text-center" style="width:150px;">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@c.BrandName</td>
                            <td class="text-muted">@c.BrandDescription</td>
                            <td class="text-muted">@c.WebsiteUrl</td>
                            @if (User.IsInRole("Admin"))
                            {
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@c.Id"
                                       class="btn btn-sm btn-outline-warning me-2">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@c.Id" method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Delete brand: @c.BrandName?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="text-muted small mt-2">
            Showing @Model.Items.Count of @Model.TotalCount results.
        </div>
    }
    <form id="pageForm" method="get" asp-action="Index" class="d-flex align-items-center mt-3">
        <input type="hidden" name="keyword" value="@keyword" />
        <input type="hidden" name="pageSize" value="10" />

        <button id="btnPre" type="button" class="btn btn-secondary me-2" onclick="changePage(-1)">
            <i class="bi bi-chevron-left"></i> Previous
        </button>

        <span>Page</span>
        <input type="number" id="pageInput" name="page" value="@currentPage"
               min="1" max="@maxPage"
               onchange="validatePage()" class="form-control mx-2" style="width:80px;" />
        <span id="pageDisplay">@currentPage</span>
        <span class="mx-2">/ @maxPage</span>

        <button id="btnNext" type="button" class="btn btn-secondary ms-2" onclick="changePage(1)">
            Next <i class="bi bi-chevron-right"></i>
        </button>
    </form>


@section Scripts {
        <script>
            const maxPage = @maxPage;
            const btnPre = document.getElementById("btnPre");
            const btnNext = document.getElementById("btnNext");
            const pageInput = document.getElementById("pageInput");
            const pageDisplay = document.getElementById("pageDisplay");

            function updateButtons(page) {
                btnPre.disabled = page <= 1;
                btnNext.disabled = page >= maxPage;
            }

            updateButtons(parseInt(pageInput.value));

            function changePage(delta) {
                let page = parseInt(pageInput.value) || 1;
                page += delta;

                if (page < 1) page = 1;
                if (page > maxPage) page = maxPage;

                pageInput.value = page;
                pageDisplay.textContent = page;
                updateButtons(page);

                document.getElementById("pageForm").submit();
            }

            function validatePage() {
                let page = parseInt(pageInput.value);
                if (!page || page < 1) {
                    pageInput.value = 1;
                } else if (page > maxPage) {
                    pageInput.value = maxPage;
                }
                return true;
            }
        </script>
}
