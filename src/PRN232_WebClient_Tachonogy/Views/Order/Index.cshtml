@model PRN232_WebClient_Tachonogy.DTOs.PagedResult<PRN232_WebClient_Tachonogy.DTOs.OrderDto>

@{
    ViewData["Title"] = "Order List";
    var currentPage = ViewBag.Page ?? 1;
    var maxPage = ViewBag.MaxPage ?? 1;
}

<div class="container py-4">
    <h2 class="text-center mb-4 fw-bold text-primary">
        <i class="bi bi-basket3 me-2"></i>@ViewData["Title"]
    </h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success text-center fw-semibold">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger text-center fw-semibold">@TempData["ErrorMessage"]</div>
    }

    
    {
        <div class="mb-3">
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-lg me-1"></i> Add New Order
            </a>
        </div>
    }

    @if (Model == null || !Model.Items.Any())
    {
        <div class="alert alert-info text-center py-4">
            <i class="bi bi-info-circle me-1"></i> No orders found.
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded-4 overflow-hidden">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark text-white text-uppercase">
                    <tr>
                        <th>Order Date</th>
                        <th>Total Amount</th>
                        <th>Status</th>
                        <th class="text-center" style="width:120px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.Items)
                    {
                        <tr>
                            <td>@o.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@o.TotalAmount.ToString("C")</td>
                            <td>@o.Status</td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@o.Id"
                                   class="btn btn-sm btn-outline-info me-2">
                                    <i class="bi bi-eye"></i> View
                                </a>

                                {
                                    <a asp-action="Edit" asp-route-id="@o.Id"
                                       class="btn btn-sm btn-outline-warning me-2">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </a>
                                }

                                @* Nút Delete luôn hiện cho tất cả *@
                                <form asp-action="Delete" asp-route-id="@o.Id" method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Delete order: @o.Id?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="text-muted small mt-2">
            Showing @Model.Items.Count of @Model.TotalCount results.
        </div>

        @* Pagination *@
        <form id="pageForm" method="get" asp-action="Index" class="d-flex align-items-center mt-3">
            <input type="hidden" name="pageSize" value="10" />

            <button id="btnPre" type="button" class="btn btn-secondary me-2" onclick="changePage(-1)">
                <i class="bi bi-chevron-left"></i> Previous
            </button>

            <span>Page</span>
            <input type="number" id="pageInput" name="page" value="@currentPage"
                   min="1" max="@maxPage"
                   onchange="validatePage()" class="form-control mx-2" style="width:80px;" />
            <span id="pageDisplay">@currentPage</span>
            <span class="mx-2">/ @maxPage</span>

            <button id="btnNext" type="button" class="btn btn-secondary ms-2" onclick="changePage(1)">
                Next <i class="bi bi-chevron-right"></i>
            </button>
        </form>
    }
</div>

@section Scripts {
    <script>
        const maxPage = @maxPage;
        const btnPre = document.getElementById("btnPre");
        const btnNext = document.getElementById("btnNext");
        const pageInput = document.getElementById("pageInput");
        const pageDisplay = document.getElementById("pageDisplay");

        function updateButtons(page) {
            btnPre.disabled = page <= 1;
            btnNext.disabled = page >= maxPage;
        }

        updateButtons(parseInt(pageInput.value));

        function changePage(delta) {
            let page = parseInt(pageInput.value) || 1;
            page += delta;
            if (page < 1) page = 1;
            if (page > maxPage) page = maxPage;

            pageInput.value = page;
            pageDisplay.textContent = page;
            updateButtons(page);
            document.getElementById("pageForm").submit();
        }

        function validatePage() {
            let page = parseInt(pageInput.value);
            if (!page || page < 1) pageInput.value = 1;
            else if (page > maxPage) pageInput.value = maxPage;
            return true;
        }
    </script>
}
