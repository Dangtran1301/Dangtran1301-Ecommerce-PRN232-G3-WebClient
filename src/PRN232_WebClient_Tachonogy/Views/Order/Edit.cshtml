@model PRN232_WebClient_Tachonogy.DTOs.UpdateOrderRequest

@{
    ViewData["Title"] = "Edit Order";
}

<div class="container py-4">
    <h2 class="text-center mb-4 fw-bold text-primary">
        <i class="bi bi-pencil-square me-2"></i>@ViewData["Title"]
    </h2>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form asp-action="Edit" method="post">
        @* Hidden input để gửi Order Id *@
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Status" class="form-label">Order Status</label>
            <select asp-for="Status" class="form-select">
                <option value="0" selected="@(Model.Status == 0)">Pending</option>
                <option value="1" selected="@(Model.Status == 1)">Paid</option>
                <option value="2" selected="@(Model.Status == 2)">Cancelled</option>
                <option value="3" selected="@(Model.Status == 3)">Completed</option>
            </select>
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-success">Update Order</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
