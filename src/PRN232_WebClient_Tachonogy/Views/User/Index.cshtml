@model PRN232_WebClient_Tachonogy.DTOs.PagedResult<PRN232_WebClient_Tachonogy.DTOs.UserDto>

@{
    ViewData["Title"] = "List User";
}

<h2>@ViewData["Title"]</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">+ Add new user</a>
</div>

@if (!Model.Items.Any())
{
    <p>No users.</p>
}
else
{
    <table class="table table-bordered table-striped align-middle">
        <thead class="table-light">
            <tr>
                <th>Username</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Role</th>
                <th class="text-center" style="width:150px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model.Items)
            {
                <tr>
                    <td>@u.Username</td>
                    <td>@u.FullName</td>
                    <td>@u.Email</td>
                    <td>@u.Role</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-warning me-1">
                            <i class="bi bi-pencil-square"></i> Edit
                        </a>
                        <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Confirm delete this user?');">
                            <button type="submit" class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (Model.TotalPages > 1)
{
    const int visiblePages = 5;
    var startPage = Math.Max(1, Model.PageNumber - visiblePages / 2);
    var endPage = Math.Min(Model.TotalPages, startPage + visiblePages - 1);
    if (endPage - startPage + 1 < visiblePages)
    {
        startPage = Math.Max(1, endPage - visiblePages + 1);
    }

    <nav aria-label="Pagination" class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-PageNumber="@(Model.PageNumber - 1)">
                    Previous
                </a>
            </li>

            @if (startPage > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-PageNumber="1">1</a>
                </li>
                @if (startPage > 2)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
            }

            @for (var i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-PageNumber="@i">@i</a>
                </li>
            }

            @if (endPage < Model.TotalPages)
            {
                @if (endPage < Model.TotalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-PageNumber="@Model.TotalPages">@Model.TotalPages</a>
                </li>
            }

            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-PageNumber="@(Model.PageNumber + 1)">
                    Next
                </a>
            </li>
        </ul>
    </nav>
}
