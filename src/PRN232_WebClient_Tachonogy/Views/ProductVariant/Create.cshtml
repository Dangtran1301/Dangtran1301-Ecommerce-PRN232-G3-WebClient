@model PRN232_WebClient_Tachonogy.DTOs.CreateProductVariantRequest

@{
    ViewData["Title"] = "Create Product Variant";
    var productId = ViewBag.ProductId as Guid?;
}

<div class="container py-4">
    <h2>@ViewData["Title"]</h2>
    <div class="card">
        <div class="card-body">
            <form asp-action="Create" method="post">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                }
                
                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-warning" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        @ViewBag.ErrorMessage
                    </div>
                }
                
                <div class="mb-3">
                    <label asp-for="ProductId" class="form-label fw-semibold">Product <span class="text-danger">*</span></label>
                    @{
                        var products = ViewBag.Products as List<PRN232_WebClient_Tachonogy.DTOs.ProductDto> ?? new List<PRN232_WebClient_Tachonogy.DTOs.ProductDto>();
                    }
                    @if (products.Any())
                    {
                        <select asp-for="ProductId" class="form-select" required>
                            <option value="">-- Select Product --</option>
                            @foreach (var product in products.OrderBy(p => p.ProductName))
                            {
                                var displayName = !string.IsNullOrEmpty(product.ProductName) 
                                    ? product.ProductName 
                                    : "Unnamed Product";
                                var brandInfo = !string.IsNullOrEmpty(product.BrandName) ? product.BrandName : "Unknown Brand";
                                var categoryInfo = !string.IsNullOrEmpty(product.CategoryName) ? product.CategoryName : "Unknown Category";
                                
                                <option value="@product.Id" selected="@(productId.HasValue && productId.Value == product.Id)">
                                    @displayName (@brandInfo - @categoryInfo)
                                </option>
                            }
                        </select>
                        <small class="text-muted">Select a product to associate this variant with.</small>
                    }
                    else
                    {
                        <div class="alert alert-info" role="alert">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>No products available.</strong> Please <a asp-controller="Product" asp-action="Create" class="alert-link">create a product first</a> before creating variants.
                        </div>
                        <input type="hidden" asp-for="ProductId" value="@Guid.Empty" />
                    }
                    <span asp-validation-for="ProductId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="VariantName" class="form-label fw-semibold">Variant Name <span class="text-danger">*</span></label>
                    <input asp-for="VariantName" class="form-control" placeholder="e.g., 16GB RAM + 512GB SSD" required />
                    <span asp-validation-for="VariantName" class="text-danger"></span>
                    <small class="text-muted">Enter a descriptive name for this variant (e.g., "16GB RAM + 512GB SSD", "32GB RAM + 1TB SSD")</small>
                </div>

                <div class="mb-3">
                    <label asp-for="Price" class="form-label fw-semibold">Price <span class="text-danger">*</span></label>
                    <input asp-for="Price" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00" required />
                    <span asp-validation-for="Price" class="text-danger"></span>
                    <small class="text-muted">Enter the price for this variant (must be greater than 0)</small>
                </div>

                <div class="mb-3">
                    <label asp-for="Sku" class="form-label fw-semibold">SKU (Optional)</label>
                    <input asp-for="Sku" class="form-control" placeholder="e.g., VAR-001" />
                    <span asp-validation-for="Sku" class="text-danger"></span>
                    <small class="text-muted">Optional: Stock Keeping Unit for inventory management</small>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageUrl" class="form-label fw-semibold">Image URL (Optional)</label>
                    <input asp-for="ImageUrl" type="text" class="form-control" placeholder="https://example.com/image.jpg" />
                    <span asp-validation-for="ImageUrl" class="text-danger"></span>
                    <small class="text-muted">Optional: URL to an image for this variant. Leave empty if no image available.</small>
                </div>

                <button type="submit" class="btn btn-success">Create</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


