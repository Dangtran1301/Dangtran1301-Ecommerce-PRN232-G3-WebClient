@model PRN232_WebClient_Tachonogy.DTOs.ProductVariantDto

@{
    ViewData["Title"] = "Product Variant Details";
}

<div class="container py-4">
    <h2>@ViewData["Title"]</h2>
    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Variant Name:</dt>
                <dd class="col-sm-9">@Model.VariantName</dd>

                <dt class="col-sm-3">Price:</dt>
                <dd class="col-sm-9 text-success fw-bold">$@Model.Price.ToString("N2")</dd>

                <dt class="col-sm-3">SKU:</dt>
                <dd class="col-sm-9">@Model.Sku</dd>

                <dt class="col-sm-3">Product ID:</dt>
                <dd class="col-sm-9">@Model.ProductId</dd>
            </dl>
            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </div>
    </div>
</div>


