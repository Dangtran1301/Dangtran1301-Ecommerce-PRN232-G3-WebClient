@model PRN232_WebClient_Tachonogy.DTOs.PagedResult<PRN232_WebClient_Tachonogy.DTOs.StockDto>

@{
    ViewData["Title"] = "Stock Management";
    var productId = ViewBag.ProductId as Guid?;
    var location = ViewBag.Location as string ?? "";
    var currentPage = ViewBag.Page ?? 1;
    var maxPage = ViewBag.MaxPage ?? 1;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">
            <i class="bi bi-box-seam me-2"></i>@ViewData["Title"]
        </h2>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-lg me-1"></i> Add New
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">@TempData["ErrorMessage"]</div>
    }

    <form asp-action="Index" method="get" class="mb-3">
        <div class="row g-2">
            <div class="col-md-4">
                <input type="text" name="productId" value="@productId" class="form-control" placeholder="Product ID (optional)">
            </div>
            <div class="col-md-4">
                <input type="text" name="location" value="@location" class="form-control" placeholder="Location (optional)">
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">Search</button>
            </div>
        </div>
    </form>

    @if (Model == null || !Model.Items.Any())
    {
        <div class="alert alert-info text-center">No stock records found.</div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Product ID</th>
                        <th>Quantity</th>
                        <th>Location</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th class="text-center">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var stock in Model.Items)
                    {
                        <tr>
                            <td><small class="text-muted">@stock.ProductId</small></td>
                            <td>
                                <span class="badge @(stock.Quantity > 0 ? "bg-success" : "bg-danger") fs-6">
                                    @stock.Quantity
                                </span>
                            </td>
                            <td>@stock.Location</td>
                            @if (User.IsInRole("Admin"))
                            {
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@stock.Id" class="btn btn-sm btn-outline-warning me-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@stock.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete stock record?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <form id="pageForm" method="get" asp-action="Index" class="d-flex align-items-center mt-3">
            <input type="hidden" name="productId" value="@productId" />
            <input type="hidden" name="location" value="@location" />
            <button type="button" class="btn btn-secondary me-2" onclick="changePage(-1)">Previous</button>
            <input type="number" id="pageInput" name="page" value="@currentPage" min="1" max="@maxPage" class="form-control mx-2" style="width:80px;" />
            <span>of @maxPage</span>
            <button type="button" class="btn btn-secondary ms-2" onclick="changePage(1)">Next</button>
        </form>
    }
</div>

@section Scripts {
    <script>
        function changePage(delta) {
            let page = parseInt(document.getElementById("pageInput").value) || 1;
            page += delta;
            if (page < 1) page = 1;
            if (page > @maxPage) page = @maxPage;
            document.getElementById("pageInput").value = page;
            document.getElementById("pageForm").submit();
        }
    </script>
}


